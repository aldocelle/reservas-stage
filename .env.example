# Backend PHP (api/*.php) — copiar a tu hosting y completar
DB_HOST=localhost
DB_PORT=3306
DB_NAME=reservas_stage
DB_USER=root
DB_PASS=
# Origen exacto del frontend admin para cookies (ej: https://aldocelle.github.io). Vacío = * sin cookies.
ADMIN_ORIGIN=

# Frontend (Vite) — URL base del backend PHP
# En local con proxy: /api
# En producción (Pages + hosting PHP): https://tu-dominio.cl/api
VITE_API_BASE_URL=/api
