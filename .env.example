# Backend PHP (api/*.php) — copiar a tu hosting y completar
DB_HOST=localhost
DB_PORT=3306
DB_NAME=reservas_stage
DB_USER=root
DB_PASS=
# Origen exacto del frontend admin para cookies (ej: https://aldocelle.github.io o https://<proyecto>.vercel.app).
# Vacío = * sin cookies. Si el host del origen difiere del host de la API (Vercel + Railway),
# api/config.php emite la sesión con SameSite=None; Secure (obligatorio en cross-site).
ADMIN_ORIGIN=

# Admin inicial: el contenedor lo crea/actualiza solo al arrancar (deploy Railway / docker compose).
ADMIN_EMAIL=demo@vinastage.cl
ADMIN_PASS=demo1234
# 1 = carga reservas de ejemplo la primera vez (solo si la tabla reservations está vacía).
# Los datos coinciden con el mock del frontend: "casi lleno" (19/20) hasta el 4 de oct,
# FULL (20/20) el 5 de oct, y disponible (8 y 12) los días 6 y 7.
SEED_DEMO=1

# En Railway NO hace falta definir DB_*: el contenedor lee MYSQLHOST/MYSQLPORT/MYSQLUSER/MYSQLPASSWORD/
# MYSQLDATABASE (o MYSQL_URL) del plugin MySQL del proyecto. Ver README → "Deploy en Railway".

# Frontend (Vite) — URL base del backend PHP
# En local con proxy: /api
# En producción mismo dominio (Railway): /api · con backend externo: https://tu-dominio.cl/api
VITE_API_BASE_URL=/api
# El frontend usa siempre el backend PHP/MySQL real.
VITE_DEMO_MODE=0

# Deploy del frontend en Vercel (vercel.json + scripts/vercel-deploy.sh):
# Vercel no ejecuta PHP, así que con VITE_API_BASE_URL=/api la web cae en demo. Para conectar
# la API real: VITE_DEMO_MODE=0 y VITE_API_BASE_URL=https://<app>.up.railway.app/api,
# y en el backend ADMIN_ORIGIN=https://<proyecto>.vercel.app.
