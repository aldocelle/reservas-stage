+/* Hamburguesa móvil (el .menu estaba display:none y sin handler) */
+.menu{display:none;cursor:pointer;border:1px solid rgba(255,255,255,.15);background:rgba(3,5,6,.6);border-radius:9px;width:38px;height:38px;padding:0;flex-shrink:0;transition:.2s;z-index:55}
+.menu:hover{border-color:rgba(255,255,255,.4);background:rgba(8,12,10,.9)}
+.menu span{display:block;width:22px;height:2px;background:#eee;border-radius:2px;margin:4px 0;transition:.2s}
+.menu.open span:nth-child(1){transform:rotate(45deg) translate(5px,5px);margin-top:8px}
+.menu.open span:nth-child(2){opacity:0}
+.menu.open span:nth-child(3){transform:rotate(-45deg) translate(5px,-6px);margin-bottom:8px}
+@media(max-width:760px){
+.menu{display:inline-flex;flex-direction:column;justify-content:center}
+.nav{position:fixed;top:78px;left:0;right:0;bottom:0;overflow-y:auto;background:rgba(3,5,6,.98);backdrop-filter:blur(14px);border-bottom:1px solid #fff;flex-direction:column;padding:12px 16px;gap:14px;display:none;z-index:40;box-shadow:0 10px 30px rgba(0,0,0,.6)}
+.nav.open{display:flex;animation:vs-fade-in .17s ease-out}
+@keyframes vs-fade-in{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:translateY(0)}}
+}
+.mobile-overlay{position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:35}
+.fade-enter-active,.fade-leave-active{transition:opacity .15s ease}
+.fade-enter-from,.fade-leave-to{opacity:0}
+/* Compactación reservas */
+.reservation-section{padding:42px 12px}
+.panel{padding:14px 15px}
+.panel .section-title{font-size:14px;margin-top:0}
+.day-card-head small{font-size:10px;color:#888}
+.cal-grid{gap:3px}
+.cal-cell{min-height:50px;padding:5px 3px;font-size:12px}
+.cal-cupos{font-size:10px}
+.slots{gap:8px}
+.slot{font-size:13px;padding:9px 10px}
+.slot .slot-cupos{font-size:11px}
+.schedule-heading{gap:6px}
+.schedule-heading div{font-size:12px}
+.form-grid{grid-template-columns:1fr 1fr;gap:8px}
+.field{padding:8px 10px;font-size:13px}
+.reserve-btn{padding:12px 18px}
+
+.block-list{list-style:none;display:flex;flex-wrap:wrap;gap:10px;padding:0;margin:16px 0 0}
+.block-list li{display:flex;flex-direction:column;gap:3px;border:1px solid #050505;background:#050505;border-radius:9px;padding:10px 14px;min-width:158px}
+.block-list span{font-size:10px;letter-spacing:2px;font-weight:900;color:#e10600}
+.block-list b{font-size:13px;color:#eee;font-weight:700}
+.slot .slot-range{color:#ccc;font-size:12px;margin-top:6px;letter-spacing:.3px}
+.slot .slot-cupos{color:#e10600;font-size:12px;margin-top:5px;font-weight:700}
+.slot.full{border-color:#2a0a0a;background:#050505}
+.slot-chosen{margin:0 0 14px;font-size:12px;color:#aaa}
+.slot-chosen b{color:#ffd400}
+.admin-table .muted{color:#888;font-size:11px}
+.admin-table .bloque-tag{color:#e10600;font-weight:700}
+
+.slot .solo-desktop{display:inline;margin-top:0}
+/* Responsive: los 5 dias y los 3 bloques siempre visibles */
+.day-name .short,.day-date .short{display:none}
+@media(max-width:760px){
+.days{grid-template-columns:repeat(5,minmax(0,1fr));gap:6px;overflow:visible}
+.day{min-height:94px;padding:8px 3px;border-radius:9px}
+.day-name{font-size:9px;letter-spacing:.4px}
+.day-name .long,.day-date .long{display:none}
+.day-name .short,.day-date .short{display:inline}
+.day-date{font-size:8px;letter-spacing:0;margin-top:1px}
+.ring{width:38px;height:38px;margin-top:5px}
+.ring:before{inset:4px}
+.ring-content{font-size:10px;line-height:1.1}
+.ring-content small{display:none}
+.slots{grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}
+.slot{min-height:100px;padding:10px 8px;border-radius:9px}
+.slot strong{font-size:10.5px;letter-spacing:.3px;line-height:1.15}
+.slot .slot-range{font-size:9px;margin-top:5px;line-height:1.3}
+.slot .slot-cupos{font-size:9px;margin-top:4px}
+.slot .solo-desktop{display:none}
+.tick{right:5px;top:5px;width:17px;height:17px;line-height:17px;font-size:11px}
+.block-list{gap:6px}
+.block-list li{min-width:0;flex:1 1 30%;padding:8px 9px}
+.block-list span{font-size:9px;letter-spacing:1px}
+.block-list b{font-size:11px}
+}
+@media(max-width:400px){
+.days{gap:5px}
+.day-name{font-size:8px}
+.ring{width:34px;height:34px}
+.slot{padding:9px 6px}
+.slot strong{font-size:9.5px}
+.slot .slot-range,.slot .slot-cupos{font-size:8.5px}
+}
+
+/* Calendario mensual Lun-Vie */
+.cal-nav{display:flex;align-items:center;gap:12px;margin-bottom:12px}
+.cal-nav strong{font-size:14px;letter-spacing:2px}
+.cal-nav button{width:34px;height:34px;border:1px solid #2a1a1a;background:#050505;color:#e10600;border-radius:8px;font-size:18px;line-height:1;cursor:pointer}
+.cal-nav button:disabled{opacity:.35;cursor:not-allowed}
+.cal-head{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin-bottom:6px}
+.cal-head span{text-align:center;font-size:10px;letter-spacing:1.5px;color:#888;font-weight:900}
+.cal-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}
+.cal-cell{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;min-height:66px;padding:8px 4px;border:1px solid #2a1a1a;border-radius:9px;background:#050505;color:#fff;cursor:pointer;transition:.2s}
+.cal-cell.empty{border:0;background:transparent;cursor:default;min-height:0}
+.cal-cell:not(.empty):hover,.cal-cell.active{border-color:#e10600;box-shadow:inset 0 0 0 1px #e10600}
+.cal-cell.off{opacity:.3;cursor:not-allowed}
+.cal-day{font-size:17px;font-weight:900;line-height:1}
+.cal-cupos{font-size:10px;color:#ffd400;font-weight:700}
+.cal-cell.full .cal-cupos{color:#ffd400}
+.cal-bar{display:block;width:68%;height:3px;border-radius:3px;background:#050505;overflow:hidden}
+.cal-bar i{display:block;height:100%;background:#e10600}
+.cal-note{margin:14px 0 0;color:#eee;font-size:12px}
+.cal-note b{color:#e10600}
+@media(max-width:760px){
+.cal-cell{min-height:56px;padding:6px 2px;border-radius:8px;gap:2px}
+.cal-day{font-size:14px}
+.cal-cupos{font-size:8.5px}
+.cal-head span{font-size:9px;letter-spacing:1px}
+.cal-nav button{width:30px;height:30px;font-size:16px}
+.cal-nav strong{font-size:12px;letter-spacing:1px}
+.cal-note{font-size:11px}
+}
