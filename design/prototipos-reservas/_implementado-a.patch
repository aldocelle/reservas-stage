+/* Cartelera: slider a todo el ancho de la pantalla; se detiene al presionar y sigue al soltar. */
+.events-section{max-width:none;padding:90px 0 100px}
+.events-section .section-head,.events-section .event-meta{max-width:1180px;margin-left:auto;margin-right:auto;padding:0 58px}
+.event-stage{max-width:none;width:100%;height:auto;min-height:0;margin:45px 0 15px;padding:0;perspective:none;overflow:hidden;cursor:grab;user-select:none;-webkit-user-select:none;touch-action:pan-y}
+.event-stage.held{cursor:grabbing}
+.event-track{display:flex;width:max-content;padding-bottom:6px;animation:vs-marquee 36s linear infinite;will-change:transform}
+.event-stage.held .event-track{animation-play-state:paused}
+.event-track .event-card{position:relative;left:auto;top:auto;flex:0 0 auto;width:330px;height:460px;margin-right:18px;transform:none;opacity:1;transition:none}
+@keyframes vs-marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
+@media(max-width:980px){.event-track .event-card{width:270px;height:385px}}
+@media(max-width:760px){.events-section .section-head,.events-section .event-meta{padding:0 18px}.event-track .event-card{width:230px;height:325px;margin-right:12px}}
+@media(prefers-reduced-motion:reduce){.event-track{animation:none}}
